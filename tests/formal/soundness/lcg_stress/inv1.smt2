(set-logic QF_BV)
(declare-const x (_ BitVec 6))
(declare-const y (_ BitVec 6))
(assert (bvsle (bvneg y) (bvmul y x)))
(assert (bvslt (bvmul y x) x))
(assert (bvuge (bvneg y) (concat (_ bv0 1) (_ bv8 5))))
(assert (or (bvugt (bvneg y) (_ bv32 6)) (bvsge y y)))
(assert (xor (distinct (_ bv13 6) (bvmul y x)) (bvslt x x)))
(assert (bvslt (bvurem y (bvmul y x)) y))
(check-sat)
