  (assert (= #b1 (__Vbv (=> (__Vbool write_command) (__Vbool (__Vbv (= ((_ zero_extend 29) num_lanes) #x00000001)))))))
  (assert (= #b1 (bvor (bvor (bvor (__Vbv (= ((_ zero_extend 29) num_lanes) #x00000000)) (__Vbv (= ((_ zero_extend 29) num_lanes) #x00000001))) (__Vbv (= ((_ zero_extend 29) num_lanes) #x00000002))) (__Vbv (= ((_ zero_extend 29) num_lanes) #x00000004)))))
  (check-sat)
