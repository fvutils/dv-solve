; First query of a Verilator randomize() capture of harness.sv
  (set-option :produce-models true)
  (set-option :produce-unsat-assumptions true)
  (set-logic QF_ABV)
  (define-fun __Vbv ((b Bool)) (_ BitVec 1) (ite b #b1 #b0))
  (define-fun __Vbool ((v (_ BitVec 1))) Bool (= #b1 v))
  (declare-fun __Vcmd_data_q_size () (_ BitVec 32))
  (declare-fun clen () (_ BitVec 4))
  (declare-fun flags () (_ BitVec 4))
  (declare-fun glen () (_ BitVec 12))
  (assert (= #b1 (__Vbv (or (= flags (_ bv6 4)) (= flags (_ bv9 4))))))
  (assert (= #b1 (bvand (__Vbv (bvuge ((_ zero_extend 28) clen) #x00000000)) (__Vbv (bvule ((_ zero_extend 28) clen) #x0000000c)))))
  (assert (= #b1 (__Vbv (= __Vcmd_data_q_size ((_ zero_extend 28) clen)))))
  (assert (= #b1 (__Vbv (bvsge __Vcmd_data_q_size #x00000000))))
  (assert (= #b1 (bvor (__Vbv (= flags #x6)) (__Vbv (= flags #x9)))))
  (assert (= #b1 (bvor (__Vbv (= ((_ zero_extend 20) glen) #x00000fff)) (bvor (bvand (__Vbv (bvuge ((_ zero_extend 20) glen) #x00000401)) (__Vbv (bvule ((_ zero_extend 20) glen) #x00000ffe))) (bvor (bvand (__Vbv (bvuge ((_ zero_extend 20) glen) #x00000081)) (__Vbv (bvule ((_ zero_extend 20) glen) #x00000400))) (bvor (bvand (__Vbv (bvuge ((_ zero_extend 20) glen) #x00000021)) (__Vbv (bvule ((_ zero_extend 20) glen) #x00000080))) (bvand (__Vbv (bvuge ((_ zero_extend 20) glen) #x00000001)) (__Vbv (bvule ((_ zero_extend 20) glen) #x00000020)))))))))
  (assert (= #b1 (__Vbv (= ((_ zero_extend 20) glen) #x0000000e))))
  (check-sat)
