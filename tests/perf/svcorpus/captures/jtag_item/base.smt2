; First query of a Verilator randomize() capture of harness.sv
  (set-option :produce-models true)
  (set-logic QF_ABV)
  (define-fun __Vbv ((b Bool)) (_ BitVec 1) (ite b #b1 #b0))
  (define-fun __Vbool ((v (_ BitVec 1))) Bool (= #b1 v))
  (declare-fun dr_len () (_ BitVec 32))
  (declare-fun dr_pause_count () (_ BitVec 32))
  (declare-fun dr_pause_cycle () (_ BitVec 32))
  (declare-fun dummy_dr () (_ BitVec 1))
  (declare-fun dummy_ir () (_ BitVec 1))
  (declare-fun exit_to_rti_dr () (_ BitVec 1))
  (declare-fun exit_via_pause_dr () (_ BitVec 1))
  (declare-fun exit_via_pause_ir () (_ BitVec 1))
  (declare-fun ir_len () (_ BitVec 32))
  (declare-fun ir_pause_count () (_ BitVec 32))
  (declare-fun ir_pause_cycle () (_ BitVec 32))
  (declare-fun reset_tap_fsm () (_ BitVec 1))
  (declare-fun skip_reselected_ir () (_ BitVec 1))
  (assert (= #b1 (__Vbv (bvule ir_len #x00000020))))
  (assert (= #b1 (__Vbv (bvule dr_len #x00000040))))
  (assert (= #b1 (bvor (__Vbv (bvugt ir_len #x00000000)) (__Vbv (bvugt dr_len #x00000000)))))
  (assert (= #b1 (bvor (__Vbv (= ((_ zero_extend 31) skip_reselected_ir) #x00000001)) (__Vbv (= ((_ zero_extend 31) skip_reselected_ir) #x00000000)))))
  (assert (= #b1 (__Vbv (= ((_ zero_extend 31) skip_reselected_ir) #x00000001))))
  (assert (= #b1 (bvor (bvand (__Vbv (bvuge ir_pause_count #x00000001)) (__Vbv (bvule ir_pause_count #x00000028))) (__Vbv (= ir_pause_count #x00000000)))))
  (assert (= #b1 (__Vbv (= ir_pause_count #x00000000))))
  (assert (= #b1 (bvor (bvand (__Vbv (bvuge dr_pause_count #x00000001)) (__Vbv (bvule dr_pause_count #x00000028))) (__Vbv (= dr_pause_count #x00000000)))))
  (assert (= #b1 (__Vbv (= dr_pause_count #x00000025))))
  (assert (= #b1 (ite (__Vbool (bvand (__Vbv (bvugt dr_pause_count #x00000000)) (__Vbv (bvugt dr_len #x00000003)))) (bvand (__Vbv (bvuge dr_pause_cycle #x00000001)) (__Vbv (bvule dr_pause_cycle (bvsub dr_len #x00000003)))) (__Vbv (= dr_pause_cycle #x00000000)))))
  (assert (= #b1 (ite (__Vbool (bvand (__Vbv (bvugt ir_pause_count #x00000000)) (__Vbv (bvugt ir_len #x00000003)))) (bvand (__Vbv (bvuge ir_pause_cycle #x00000001)) (__Vbv (bvule ir_pause_cycle (bvsub ir_len #x00000003)))) (__Vbv (= ir_pause_cycle #x00000000)))))
  (assert (= #b1 (bvor (__Vbv (= ((_ zero_extend 31) dummy_ir) #x00000001)) (__Vbv (= ((_ zero_extend 31) dummy_ir) #x00000000)))))
  (assert (= #b1 (__Vbv (= ((_ zero_extend 31) dummy_ir) #x00000000))))
  (assert (= #b1 (bvor (__Vbv (= ((_ zero_extend 31) exit_via_pause_ir) #x00000001)) (__Vbv (= ((_ zero_extend 31) exit_via_pause_ir) #x00000000)))))
  (assert (= #b1 (__Vbv (= ((_ zero_extend 31) exit_via_pause_ir) #x00000000))))
  (assert (= #b1 (bvor (__Vbv (= ((_ zero_extend 31) exit_via_pause_dr) #x00000001)) (__Vbv (= ((_ zero_extend 31) exit_via_pause_dr) #x00000000)))))
  (assert (= #b1 (__Vbv (= ((_ zero_extend 31) exit_via_pause_dr) #x00000000))))
  (push 1)
  (assert (= #b1 (__Vbv (= ((_ zero_extend 31) exit_to_rti_dr) #x00000001))))
  (assert (= #b1 (__Vbv (= ((_ zero_extend 31) reset_tap_fsm) #x00000000))))
  (assert (= #b1 (__Vbv (= ((_ zero_extend 31) dummy_dr) #x00000000))))
  (check-sat)
