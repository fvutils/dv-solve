; large-memory BMC: 24-bit address, depth 16 -- expects UNSAT
; Single memory threaded through a store chain, NO array equality
; (non-extensional): the read-back at a0 pushes through the full chain.
(set-logic QF_ABV)
(declare-fun mem () (Array (_ BitVec 24) (_ BitVec 32)))
(declare-fun a0 () (_ BitVec 24))
(declare-fun v  () (_ BitVec 32))
(declare-fun a1 () (_ BitVec 24))
(declare-fun w1 () (_ BitVec 32))
(declare-fun a2 () (_ BitVec 24))
(declare-fun w2 () (_ BitVec 32))
(declare-fun a3 () (_ BitVec 24))
(declare-fun w3 () (_ BitVec 32))
(declare-fun a4 () (_ BitVec 24))
(declare-fun w4 () (_ BitVec 32))
(declare-fun a5 () (_ BitVec 24))
(declare-fun w5 () (_ BitVec 32))
(declare-fun a6 () (_ BitVec 24))
(declare-fun w6 () (_ BitVec 32))
(declare-fun a7 () (_ BitVec 24))
(declare-fun w7 () (_ BitVec 32))
(declare-fun a8 () (_ BitVec 24))
(declare-fun w8 () (_ BitVec 32))
(declare-fun a9 () (_ BitVec 24))
(declare-fun w9 () (_ BitVec 32))
(declare-fun a10 () (_ BitVec 24))
(declare-fun w10 () (_ BitVec 32))
(declare-fun a11 () (_ BitVec 24))
(declare-fun w11 () (_ BitVec 32))
(declare-fun a12 () (_ BitVec 24))
(declare-fun w12 () (_ BitVec 32))
(declare-fun a13 () (_ BitVec 24))
(declare-fun w13 () (_ BitVec 32))
(declare-fun a14 () (_ BitVec 24))
(declare-fun w14 () (_ BitVec 32))
(declare-fun a15 () (_ BitVec 24))
(declare-fun w15 () (_ BitVec 32))
(declare-fun a16 () (_ BitVec 24))
(declare-fun w16 () (_ BitVec 32))
(define-fun mem1 () (Array (_ BitVec 24) (_ BitVec 32)) (store mem a0 v))
(define-fun mem2 () (Array (_ BitVec 24) (_ BitVec 32)) (store mem1 a1 w1))
(define-fun mem3 () (Array (_ BitVec 24) (_ BitVec 32)) (store mem2 a2 w2))
(define-fun mem4 () (Array (_ BitVec 24) (_ BitVec 32)) (store mem3 a3 w3))
(define-fun mem5 () (Array (_ BitVec 24) (_ BitVec 32)) (store mem4 a4 w4))
(define-fun mem6 () (Array (_ BitVec 24) (_ BitVec 32)) (store mem5 a5 w5))
(define-fun mem7 () (Array (_ BitVec 24) (_ BitVec 32)) (store mem6 a6 w6))
(define-fun mem8 () (Array (_ BitVec 24) (_ BitVec 32)) (store mem7 a7 w7))
(define-fun mem9 () (Array (_ BitVec 24) (_ BitVec 32)) (store mem8 a8 w8))
(define-fun mem10 () (Array (_ BitVec 24) (_ BitVec 32)) (store mem9 a9 w9))
(define-fun mem11 () (Array (_ BitVec 24) (_ BitVec 32)) (store mem10 a10 w10))
(define-fun mem12 () (Array (_ BitVec 24) (_ BitVec 32)) (store mem11 a11 w11))
(define-fun mem13 () (Array (_ BitVec 24) (_ BitVec 32)) (store mem12 a12 w12))
(define-fun mem14 () (Array (_ BitVec 24) (_ BitVec 32)) (store mem13 a13 w13))
(define-fun mem15 () (Array (_ BitVec 24) (_ BitVec 32)) (store mem14 a14 w14))
(define-fun mem16 () (Array (_ BitVec 24) (_ BitVec 32)) (store mem15 a15 w15))
(define-fun mem17 () (Array (_ BitVec 24) (_ BitVec 32)) (store mem16 a16 w16))
(assert (not (= a1 a0)))
(assert (not (= a2 a0)))
(assert (not (= a3 a0)))
(assert (not (= a4 a0)))
(assert (not (= a5 a0)))
(assert (not (= a6 a0)))
(assert (not (= a7 a0)))
(assert (not (= a8 a0)))
(assert (not (= a9 a0)))
(assert (not (= a10 a0)))
(assert (not (= a11 a0)))
(assert (not (= a12 a0)))
(assert (not (= a13 a0)))
(assert (not (= a14 a0)))
(assert (not (= a15 a0)))
(assert (not (= a16 a0)))
(assert (not (= (select mem17 a0) v)))
(check-sat)
