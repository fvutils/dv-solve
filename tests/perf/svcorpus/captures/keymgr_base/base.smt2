; First query of a Verilator randomize() capture of harness.sv
  (set-option :produce-models true)
  (set-option :produce-unsat-assumptions true)
  (set-logic QF_ABV)
  (define-fun __Vbv ((b Bool)) (_ BitVec 1) (ite b #b1 #b0))
  (define-fun __Vbool ((v (_ BitVec 1))) Bool (= #b1 v))
  (declare-fun do_invalid_otp_key () (_ BitVec 1))
  (declare-fun do_rand_otp_key () (_ BitVec 1))
  (declare-fun gen_operation () (_ BitVec 3))
  (declare-fun is_key_version_err () (_ BitVec 1))
  (assert (= #b1 (__Vbv (or (= gen_operation (_ bv0 3)) (= gen_operation (_ bv1 3)) (= gen_operation (_ bv2 3)) (= gen_operation (_ bv3 3)) (= gen_operation (_ bv4 3))))))
  (assert (= #b1 (__Vbv (= ((_ zero_extend 31) is_key_version_err) #x00000000))))
  (assert (= #b1 (__Vbv (= ((_ zero_extend 31) do_rand_otp_key) #x00000000))))
  (assert (= #b1 (__Vbv (= ((_ zero_extend 31) do_invalid_otp_key) #x00000000))))
  (assert (= #b1 (bvor (bvor (__Vbv (= gen_operation #b001)) (__Vbv (= gen_operation #b010))) (__Vbv (= gen_operation #b011)))))
  (check-sat)
