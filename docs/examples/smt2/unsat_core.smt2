(set-option :produce-unsat-cores true)
(set-logic QF_BV)
(declare-const len (_ BitVec 16))
(declare-const hdr (_ BitVec 16))
(assert (! (bvuge len #x0040) :named len_min))
(assert (! (bvule len #x05dc) :named len_max))
(assert (! (bvult hdr len) :named hdr_fits))
(assert (! (bvult len #x0028) :named short))
(check-sat)
(get-unsat-core)
