; First query of a Verilator randomize() capture of harness.sv
  (set-option :produce-models true)
  (set-option :produce-unsat-assumptions true)
  (set-logic QF_ABV)
  (define-fun __Vbv ((b Bool)) (_ BitVec 1) (ite b #b1 #b0))
  (define-fun __Vbool ((v (_ BitVec 1))) Bool (= #b1 v))
  (declare-fun ack_delay () (_ BitVec 32))
  (declare-fun ack_stable () (_ BitVec 32))
  (declare-fun alert_delay () (_ BitVec 32))
  (declare-fun alert_int_err_type () (_ BitVec 2))
  (declare-fun int_err_cyc () (_ BitVec 32))
  (declare-fun ping_delay () (_ BitVec 32))
  (declare-fun r_alert_ping_send () (_ BitVec 1))
  (declare-fun r_alert_rsp () (_ BitVec 1))
  (declare-fun r_esc_rsp () (_ BitVec 1))
  (declare-fun s_alert_ping_rsp () (_ BitVec 1))
  (declare-fun s_alert_send () (_ BitVec 1))
  (assert (= #b1 (__Vbv (or (= alert_int_err_type (_ bv0 2)) (= alert_int_err_type (_ bv1 2)) (= alert_int_err_type (_ bv2 2)) (= alert_int_err_type (_ bv3 2))))))
  (assert (= #b1 (bvor (bvand (__Vbv (bvuge ping_delay #x00000001)) (__Vbv (bvule ping_delay #x0000000a))) (__Vbv (= ping_delay #x00000000)))))
  (assert (= #b1 (__Vbv (= ping_delay #x00000005))))
  (assert (= #b1 (bvor (bvand (__Vbv (bvuge ack_delay #x00000001)) (__Vbv (bvule ack_delay #x0000000a))) (__Vbv (= ack_delay #x00000000)))))
  (assert (= #b1 (__Vbv (= ack_delay #x00000000))))
  (assert (= #b1 (bvor (bvand (__Vbv (bvuge alert_delay #x00000001)) (__Vbv (bvule alert_delay #x0000000a))) (__Vbv (= alert_delay #x00000000)))))
  (assert (= #b1 (__Vbv (= alert_delay #x00000000))))
  (assert (= #b1 (bvor (bvand (__Vbv (bvuge ack_stable #x00000002)) (__Vbv (bvule ack_stable #x0000000a))) (__Vbv (= ack_stable #x00000001)))))
  (assert (= #b1 (__Vbv (= ack_stable #x00000001))))
  (assert (= #b1 (bvor (bvand (__Vbv (bvuge int_err_cyc #x00000002)) (__Vbv (bvule int_err_cyc #x0000000a))) (__Vbv (= int_err_cyc #x00000001)))))
  (assert (= #b1 (__Vbv (= int_err_cyc #x0000000a))))
  (assert (= #b1 (__Vbv (=> (__Vbool (__Vbv (= ((_ zero_extend 31) r_esc_rsp) #x00000001))) (__Vbool (bvand (bvand (bvand (__Vbv (not (__Vbool s_alert_send))) (__Vbv (not (__Vbool r_alert_rsp)))) (__Vbv (not (__Vbool r_alert_ping_send)))) (__Vbv (not (__Vbool s_alert_ping_rsp)))))))))
  (assert (= #b1 (__Vbv (=> (__Vbool (bvor (bvor (bvor s_alert_send r_alert_rsp) r_alert_ping_send) s_alert_ping_rsp)) (__Vbool (__Vbv (not (__Vbool r_esc_rsp))))))))
  (assert (= #b1 (__Vbv (= alert_int_err_type #b00))))
  (check-sat)
