; First query of a Verilator randomize() capture of harness.sv
  (set-option :produce-models true)
  (set-option :produce-unsat-assumptions true)
  (set-logic QF_ABV)
  (define-fun __Vbv ((b Bool)) (_ BitVec 1) (ite b #b1 #b0))
  (define-fun __Vbool ((v (_ BitVec 1))) Bool (= #b1 v))
  (declare-fun __Vdata_size () (_ BitVec 32))
  (declare-fun dummy_csb_length_ns () (_ BitVec 32))
  (declare-fun dummy_sck_cnt () (_ BitVec 32))
  (declare-fun item_type () (_ BitVec 32))
  (declare-fun num_lanes () (_ BitVec 3))
  (declare-fun write_command () (_ BitVec 1))
  (assert (= #b1 (__Vbv (or (= item_type (_ bv0 32)) (= item_type (_ bv1 32)) (= item_type (_ bv2 32)) (= item_type (_ bv3 32))))))
  (assert (= #b1 (bvand (__Vbv (bvsge __Vdata_size #x00000000)) (__Vbv (bvsle __Vdata_size #x00010000)))))
  (assert (= #b1 (__Vbv (bvsge __Vdata_size #x00000000))))
  (assert (= #b1 (ite (__Vbool (__Vbv (= item_type #x00000001))) (bvand (__Vbv (bvuge dummy_sck_cnt #x00000001)) (__Vbv (bvule dummy_sck_cnt #x000003e8))) (__Vbv (= dummy_sck_cnt #x00000000)))))
