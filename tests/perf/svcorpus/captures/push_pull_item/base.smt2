; First query of a Verilator randomize() capture of harness.sv
  (set-option :produce-models true)
  (set-option :produce-unsat-assumptions true)
  (set-logic QF_ABV)
  (define-fun __Vbv ((b Bool)) (_ BitVec 1) (ite b #b1 #b0))
  (define-fun __Vbool ((v (_ BitVec 1))) Bool (= #b1 v))
  (declare-fun ack_lo_delay () (_ BitVec 32))
  (declare-fun device_delay () (_ BitVec 32))
  (declare-fun host_delay () (_ BitVec 32))
  (declare-fun req_lo_delay () (_ BitVec 32))
  (push 1)
  (assert (= #b1 (__Vbv (bvule host_delay #x000003e8))))
  (assert (= #b1 (__Vbv (bvule device_delay #x000003e8))))
  (assert (= #b1 (__Vbv (bvule req_lo_delay #x000003e8))))
  (assert (= #b1 (__Vbv (bvule ack_lo_delay #x000003e8))))
  (check-sat)
