; First query of a Verilator randomize() capture of harness.sv
  (set-option :produce-models true)
  (set-option :produce-unsat-assumptions true)
  (set-logic QF_ABV)
  (define-fun __Vbv ((b Bool)) (_ BitVec 1) (ite b #b1 #b0))
  (define-fun __Vbool ((v (_ BitVec 1))) Bool (= #b1 v))
  (declare-fun a_addr () (_ BitVec 32))
  (declare-fun a_mask () (_ BitVec 4))
  (declare-fun a_opcode () (_ BitVec 3))
  (declare-fun a_param () (_ BitVec 3))
  (declare-fun a_size () (_ BitVec 2))
  (declare-fun a_valid_delay () (_ BitVec 32))
  (declare-fun a_valid_len () (_ BitVec 32))
  (declare-fun d_error () (_ BitVec 1))
  (declare-fun d_opcode () (_ BitVec 3))
  (declare-fun d_param () (_ BitVec 3))
  (declare-fun d_valid_delay () (_ BitVec 32))
  (declare-fun d_valid_len () (_ BitVec 32))
  (assert (= #b1 (__Vbv (= ((_ zero_extend 29) a_param) #x00000000))))
  (assert (= #b1 (__Vbv (= ((_ zero_extend 29) d_param) #x00000000))))
  (assert (= #b1 (bvand (__Vbv (bvuge a_valid_len #x00000001)) (__Vbv (bvule a_valid_len #x0000000a)))))
  (assert (= #b1 (bvand (__Vbv (bvuge d_valid_len #x00000001)) (__Vbv (bvule d_valid_len #x0000000a)))))
  (assert (= #b1 (bvand (__Vbv (bvuge a_valid_delay #x00000000)) (__Vbv (bvule a_valid_delay #x00000032)))))
  (assert (= #b1 (bvand (__Vbv (bvuge d_valid_delay #x00000000)) (__Vbv (bvule d_valid_delay #x00000032)))))
  (assert (= #b1 (bvor (__Vbv (= d_opcode #b001)) (__Vbv (= d_opcode #b000)))))
  (assert (= #b1 (bvor (bvor (__Vbv (= a_opcode #b100)) (__Vbv (= a_opcode #b000))) (__Vbv (= a_opcode #b001)))))
  (assert (= #b1 (__Vbv (bvsle ((_ zero_extend 28) (bvadd (bvadd (bvadd (bvand (bvxor a_mask ((_ repeat 1) (concat ((_ extract 2 0) a_mask) #b0))) #x1) (bvlshr (bvand (bvxor a_mask ((_ repeat 1) (concat ((_ extract 2 0) a_mask) #b0))) #x2) #x1)) (bvlshr (bvand (bvxor a_mask ((_ repeat 1) (concat ((_ extract 2 0) a_mask) #b0))) #x4) #x2)) (bvlshr (bvand (bvxor a_mask ((_ repeat 1) (concat ((_ extract 2 0) a_mask) #b0))) #x8) #x3))) #x00000002))))
  (assert (= #b1 (__Vbv (=> (__Vbool (__Vbv (= a_opcode #b000))) (__Vbool (__Vbv (= ((_ zero_extend 28) (bvadd (bvadd (bvadd (bvand a_mask #x1) (bvlshr (bvand a_mask #x2) #x1)) (bvlshr (bvand a_mask #x4) #x2)) (bvlshr (bvand a_mask #x8) #x3))) (bvshl #x00000001 ((_ zero_extend 30) a_size)))))))))
  (assert (= #b1 (__Vbv (= (bvand ((_ zero_extend 28) a_mask) (bvnot (bvshl (bvsub (bvshl #x00000001 (bvshl #x00000001 ((_ zero_extend 30) a_size))) #x00000001) ((_ zero_extend 30) ((_ extract 1 0) a_addr))))) #x00000000))))
  (assert (= #b1 (__Vbv (= (bvand a_addr (bvsub (bvshl #x00000001 ((_ zero_extend 30) a_size)) #x00000001)) #x00000000))))
  (assert (= #b1 (__Vbv (bvule ((_ zero_extend 30) a_size) #x00000002))))
  (push 1)
  (assert (= #b1 (__Vbv (= ((_ zero_extend 31) d_error) #x00000000))))
  (check-sat)
