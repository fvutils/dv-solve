; First query of a Verilator randomize() capture of harness.sv
  (set-option :produce-models true)
  (set-option :produce-unsat-assumptions true)
  (set-logic QF_ABV)
  (define-fun __Vbv ((b Bool)) (_ BitVec 1) (ite b #b1 #b0))
  (define-fun __Vbool ((v (_ BitVec 1))) Bool (= #b1 v))
  (declare-fun address_range_valid () (_ BitVec 1))
  (declare-fun ibmbx_base_addr () (_ BitVec 32))
  (declare-fun ibmbx_limit_addr () (_ BitVec 32))
  (declare-fun obmbx_base_addr () (_ BitVec 32))
  (declare-fun obmbx_limit_addr () (_ BitVec 32))
  (declare-fun request_dwords () (_ BitVec 11))
  (declare-fun response_dwords () (_ BitVec 11))
  (assert (= #b1 (__Vbv (bvult ibmbx_limit_addr #x40000000))))
  (assert (= #b1 (__Vbv (bvuge ibmbx_limit_addr ibmbx_base_addr))))
  (assert (= #b1 (__Vbv (bvuge (bvudiv (bvsub ibmbx_limit_addr ibmbx_base_addr) #x00000004) #x00000400))))
  (assert (= #b1 (__Vbv (bvult obmbx_limit_addr #x40000000))))
  (assert (= #b1 (__Vbv (bvuge obmbx_limit_addr obmbx_base_addr))))
  (assert (= #b1 (__Vbv (= address_range_valid #b1))))
  (assert (= #b1 (bvand (__Vbv (bvugt ((_ zero_extend 21) request_dwords) #x00000000)) (__Vbv (bvult ((_ zero_extend 21) request_dwords) #x00000400)))))
  (assert (= #b1 (bvand (__Vbv (bvugt ((_ zero_extend 21) response_dwords) #x00000000)) (__Vbv (bvule ((_ zero_extend 21) response_dwords) #x00000400)))))
  (assert (= #b1 (bvor (__Vbv (bvult ibmbx_limit_addr obmbx_base_addr)) (__Vbv (bvugt ibmbx_base_addr obmbx_limit_addr)))))
  (assert (= #b1 (__Vbv (= ((_ zero_extend 30) ((_ extract 1 0) ibmbx_base_addr)) #x00000000))))
  (assert (= #b1 (__Vbv (= ((_ zero_extend 30) ((_ extract 1 0) ibmbx_limit_addr)) #x00000000))))
  (assert (= #b1 (__Vbv (= ((_ zero_extend 30) ((_ extract 1 0) obmbx_base_addr)) #x00000000))))
  (assert (= #b1 (__Vbv (= ((_ zero_extend 30) ((_ extract 1 0) obmbx_limit_addr)) #x00000000))))
  (check-sat)
